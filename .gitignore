# bench-time compiled metallibs (regenerable)
Scripts/bench/*/bench.metalib

# Experiment windows (race/build/accept logs) — local only.
/out/

# Downloaded model weights (tens of GB; never in git).
models/

# Private engineering material: specs, design notes, plans, research and
# performance reports stay on the owner's machine and are never published.
# docs/ is private by default; the public user manual is un-ignored below.
/specs/
/docs/*
/.hermes/
/handoff.md
/1M_context.md
/Phase2_*.md
/prerelease_*.md
/ui/stitch_*/
/.vscode/
/findings.md
/progress.md
/task_plan.md
/mixed_quant_plan.md

# Release tooling (DMG installer, Hugging Face model cards and publishing scripts) is kept local.
/release/

# Public user manual (tracked; everything else under docs/ stays private,
# including docs/open-source-standards.md — the owner's internal release standard).
!/docs/lsa.md
!/docs/lsa-codebase-memory-whitepaper.md
!/docs/benchmarks.md
!/docs/quantization.md
!/docs/tuning.md
!/docs/menu-bar-app.md
