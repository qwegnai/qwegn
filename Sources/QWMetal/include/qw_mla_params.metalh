// qw_mla_params.metalh — Parameter blocks shared by NoPE and Decoupled-RoPE MLA kernels.
// Layouts mirror AbsorbParams / SparseAttnParams / DSASparseAttnParams in QWMLAAttnOperator.

#pragma once
#include <metal_stdlib>
using namespace metal;

struct MLAAbsorbParams {
    uint T;
    uint qHeads;
    uint nopeDim;
    uint vHeadDim;
    uint kvLoraRank;
    uint qFullStride;
    uint bits;
    uint group;
    uint isIncumbent;
};

struct MLASparseAttnParams {
    uint T;
    uint pos0;
    uint qHeads;
    uint headDim;
    uint kvLoraRank;
    uint topKPools;
    uint listStride;
    uint kvMode;
};

struct MLADSASparseAttnParams {
    uint T;
    uint pos0;
    uint qHeads;
    uint headDim;
    uint kvLoraRank;
    uint topK;
    uint windowTokens;
    uint listStride;
    uint kvMode;
    uint ropeDim;
    uint qRopeOffset;
    uint qFullStride;
    uint hasSink;
};
