// qw_mla_nax_common.metalh — Shared NAX sparse attention templates for MLA and
// decoupled-RoPE DSA (16-head 128T and 32-head 256T threadgroup layouts).
#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
#if !defined(__ENVIRONMENT_OS_VERSION_MIN_REQUIRED__) || __ENVIRONMENT_OS_VERSION_MIN_REQUIRED__ < 260200
#error "NAX cooperative_tensor kernels require -mmacosx-version-min=26.2 or newer (Apple MPP operand_index ABI)."
#endif
#include "mlx/backend/metal/kernels/steel/defines.h"
#include "mlx/backend/metal/kernels/steel/utils/integral_constant.h"
#include "mlx/backend/metal/kernels/steel/gemm/nax.h"
#include "qw_mla_params.metalh"
using namespace metal;
using namespace mlx::steel;

#define MLA_NAX_HG   16u
#define MLA_NAX_BK   32u
#define MLA_NAX_RANK 512u
#define MLA_NAX_DSG  128u

typedef BaseNAXFrag::dtype_frag_t<half>  mla_hfrag;
typedef BaseNAXFrag::dtype_frag_t<float> mla_ffrag;

// IEEE-754 half bit-cast for nibbles in 0..15 (0-ULP identical to half4(nibs)).
METAL_FUNC half4 qwg_mla_nax_dequant_q4(device const uchar* qRow, short d, half2 smQ4) {
    const ushort packed = *(device const ushort*)(qRow + d * 8);
    const ushort4 nibs = (ushort4(packed) >> ushort4(0u, 4u, 8u, 12u)) & ushort4(0x000Fu);
    const half4 nh = as_type<half4>(ushort4(nibs | ushort4(0x6400u))) - half4(1024.0h);
    return fma(nh, half4(smQ4.x), half4(smQ4.y));
}

template <bool SPLIT, uint KV_MODE, uint NG>
METAL_FUNC void qwg_mla_nax_attend(
    device const half* qAbs, device const half* kPool, device const half* vPool,
    device const int* kTable, device const int* vTable, device const int* blockList,
    device half* uLatOut, device float2* partML, constant MLASparseAttnParams& p,
    uint t, uint h0, uint z, uint nSplit, uint tid, uint sg_h, uint sg_d, uint lane,
    threadgroup float* sPart, threadgroup uint* blkIdx
) {
    const uint halfRank = MLA_NAX_RANK / 2u;
    const uint pq = p.pos0 + t;
    const uint nPools = (pq + 1u) >> 2u;
    const uint cnt = min(min(p.topKPools, 1024u), nPools);
    const uint tailStart = nPools << 2u;
    const uint selSlots = cnt << 2u;
    const uint slots = selSlots + (pq + 1u - tailStart);
    const float scale2 = rsqrt(float(p.headDim)) * 1.4426950408889634f;
    uint sBegin = 0u, sEnd = slots;
    if (SPLIT) {
        const uint chunk = (((slots + nSplit - 1u) / nSplit) + MLA_NAX_BK - 1u) & ~(MLA_NAX_BK - 1u);
        sBegin = min(slots, z * chunk);
        sEnd = min(slots, sBegin + chunk);
    }

    const uint nThreads = NG * 128u;
    if (nPools <= p.topKPools) {
        for (uint i = tid; i < cnt; i += nThreads) blkIdx[i] = i << 2u;
    } else {
        device const int* rowList = blockList + (size_t)t * p.listStride;
        for (uint i = tid; i < cnt; i += nThreads) blkIdx[i] = uint(rowList[i]) << 2u;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    const short2 sc = BaseNAXFrag::get_coord();
    const short sm = sc.y, sn = sc.x;
    device const half* pool = (sg_d < 2u) ? kPool : vPool;
    device const uchar* poolBytes = (device const uchar*)pool;
    device const int* table = (sg_d < 2u) ? kTable : vTable;
    const uint poolCol = (sg_d & 1u) * MLA_NAX_DSG + uint(sn);
    const uint q4Group = sg_d & 1u;

    mla_hfrag qf[8];
    {
        device const half* q0 = qAbs + ((size_t)t * p.qHeads + h0 + uint(sm)) * MLA_NAX_RANK
                                + sg_d * MLA_NAX_DSG + uint(sn);
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; i++) {
                const half4 v = *(device const half4*)(q0 + (size_t)i * 8u * MLA_NAX_RANK + d * 16);
                STEEL_PRAGMA_UNROLL
                for (short j = 0; j < 4; j++) qf[d][i * 4 + j] = v[j];
            }
        }
    }

    mla_ffrag oacc[8];
    STEEL_PRAGMA_UNROLL
    for (short d = 0; d < 8; d++) oacc[d] = mla_ffrag(0.0f);
    float mrow[2] = {-1e30f, -1e30f};
    float lrow[2] = {0.0f, 0.0f};

    uint buf = 0u;
    for (uint s0 = sBegin; s0 < sEnd; s0 += MLA_NAX_BK) {
        mla_hfrag kf[2][8];
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; i++) {
                const uint slot = s0 + uint(f * 16 + sm + i * 8);
                if constexpr (KV_MODE == 0u) {
                    device const half* src = nullptr;
                    if (slot < sEnd) {
                        const uint j = (slot < selSlots) ? (blkIdx[slot >> 2u] + (slot & 3u))
                                                         : (tailStart + (slot - selSlots));
                        const uint pg = uint(table[j >> 8u]);
                        src = pool + ((size_t)pg * 256u + (j & 255u)) * halfRank + poolCol;
                    }
                    STEEL_PRAGMA_UNROLL
                    for (short d = 0; d < 8; d++) {
                        const half4 v = src ? *(device const half4*)(src + d * 16) : half4(0.0h);
                        STEEL_PRAGMA_UNROLL
                        for (short j = 0; j < 4; j++) kf[f][d][i * 4 + j] = v[j];
                    }
                } else if constexpr (KV_MODE == 1u) {
                    device const char* qRow = nullptr;
                    half rowSc = 0.0h;
                    if (slot < sEnd) {
                        const uint j = (slot < selSlots) ? (blkIdx[slot >> 2u] + (slot & 3u))
                                                         : (tailStart + (slot - selSlots));
                        const uint pg = uint(table[j >> 8u]);
                        const uint pageOff = j & 255u;
                        device const uchar* pageBase = poolBytes + (size_t)pg * 66048ul;
                        rowSc = *((device const half*)(pageBase + 65536ul + (size_t)pageOff * 2ul));
                        qRow = (device const char*)(pageBase + (size_t)pageOff * 256ul + poolCol);
                    }
                    STEEL_PRAGMA_UNROLL
                    for (short d = 0; d < 8; d++) {
                        const half4 v = qRow ? (half4(*(device const char4*)(qRow + d * 16)) * rowSc) : half4(0.0h);
                        STEEL_PRAGMA_UNROLL
                        for (short j = 0; j < 4; j++) kf[f][d][i * 4 + j] = v[j];
                    }
                } else {
                    device const uchar* qRow = nullptr;
                    half2 smQ4 = half2(0.0h);
                    if (slot < sEnd) {
                        const uint j = (slot < selSlots) ? (blkIdx[slot >> 2u] + (slot & 3u))
                                                         : (tailStart + (slot - selSlots));
                        const uint pg = uint(table[j >> 8u]);
                        const uint pageOff = j & 255u;
                        device const uchar* pageBase = poolBytes + (size_t)pg * 34816ul;
                        smQ4 = *((device const half2*)(pageBase + 32768ul) + (size_t)pageOff * 2ul + q4Group);
                        qRow = pageBase + (size_t)pageOff * 128ul + (poolCol >> 1u);
                    }
                    STEEL_PRAGMA_UNROLL
                    for (short d = 0; d < 8; d++) {
                        const half4 v = qRow ? qwg_mla_nax_dequant_q4(qRow, d, smQ4) : half4(0.0h);
                        STEEL_PRAGMA_UNROLL
                        for (short j = 0; j < 4; j++) kf[f][d][i * 4 + j] = v[j];
                    }
                }
            }
        }

        mla_ffrag s[2] = {mla_ffrag(0.0f), mla_ffrag(0.0f)};
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            BaseNAXFrag::mma(s[0], s[1], qf[d], metal::false_type{},
                             kf[0][d], kf[1][d], metal::true_type{});
        }
        if constexpr (NG == 2u) {
            if (s0 > sBegin) threadgroup_barrier(mem_flags::mem_threadgroup);
        }
        threadgroup float* part = (NG == 1u)
            ? (sPart + buf * (4u * 16u * 32u))
            : (sPart + sg_h * (4u * 16u * 32u));
        STEEL_PRAGMA_UNROLL
        for (short e = 0; e < 16; e++) part[(sg_d * 16u + uint(e)) * 32u + lane] = s[e >> 3][e & 7];
        threadgroup_barrier(mem_flags::mem_threadgroup);
        STEEL_PRAGMA_UNROLL
        for (short e = 0; e < 16; e++) {
            float v = part[uint(e) * 32u + lane];
            v += part[(16u + uint(e)) * 32u + lane];
            v += part[(32u + uint(e)) * 32u + lane];
            v += part[(48u + uint(e)) * 32u + lane];
            s[e >> 3][e & 7] = v;
        }
        if constexpr (NG == 1u) buf ^= 1u;

        float mnew[2] = {mrow[0], mrow[1]};
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short loc = 0; loc < 8; loc++) {
                const uint slot = s0 + uint(f * 16 + sn + (loc & 3));
                const float x = (slot < sEnd) ? s[f][loc] * scale2 : -1e30f;
                s[f][loc] = x;
                mnew[loc >> 2] = max(mnew[loc >> 2], x);
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(1)));
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(8)));
        }

        mla_hfrag pf[2];
        float psum[2] = {0.0f, 0.0f};
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short loc = 0; loc < 8; loc++) {
                const float x = fast::exp2(s[f][loc] - mnew[loc >> 2]);
                pf[f][loc] = half(x);
                psum[loc >> 2] += x;
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            psum[i] += simd_shuffle_xor(psum[i], ushort(1));
            psum[i] += simd_shuffle_xor(psum[i], ushort(8));
            const bool grew = (mnew[i] > mrow[i]) && (mrow[i] > -1e29f);
            const float corr = grew ? fast::exp2(mrow[i] - mnew[i]) : 1.0f;
            lrow[i] = lrow[i] * corr + psum[i];
            if (grew) {
                STEEL_PRAGMA_UNROLL
                for (short d = 0; d < 8; d++) {
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) oacc[d][i * 4 + j] *= corr;
                }
            }
            mrow[i] = mnew[i];
        }

        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short pr = 0; pr < 4; pr++) {
                BaseNAXFrag::mma(oacc[2 * pr], oacc[2 * pr + 1], pf[f], metal::false_type{},
                                 kf[f][2 * pr], kf[f][2 * pr + 1], metal::false_type{});
            }
        }
    }

    STEEL_PRAGMA_UNROLL
    for (short i = 0; i < 2; i++) {
        const float inv = (lrow[i] > 0.0f) ? (1.0f / lrow[i]) : 0.0f;
        const size_t rowIdx = SPLIT ? ((size_t)t * nSplit + z) * p.qHeads + h0 + uint(sm + i * 8)
                                    : (size_t)t * p.qHeads + h0 + uint(sm + i * 8);
        if (SPLIT && sg_d == 0u && sn == 0) partML[rowIdx] = float2(mrow[i], lrow[i]);
        device half* dst = uLatOut + rowIdx * MLA_NAX_RANK + sg_d * MLA_NAX_DSG + uint(sn);
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            *(device half4*)(dst + d * 16) = half4(half(oacc[d][i * 4 + 0] * inv), half(oacc[d][i * 4 + 1] * inv),
                                                   half(oacc[d][i * 4 + 2] * inv), half(oacc[d][i * 4 + 3] * inv));
        }
    }
}

template <uint KV_MODE>
METAL_FUNC void qw_mla_dsa_nax_load_slot(
    device const half* pool, device const uchar* poolBytes, device const int* table,
    device const half* kPeCache, uint ropeDim, uint nRopeFrags, uint halfRank,
    uint poolCol, uint q4Group, uint sg_d, short sn, short f, short i,
    bool validSlot, uint tokJ,
    thread mla_hfrag* kfF, thread mla_hfrag* krfR0, thread mla_hfrag* krfR1
) {
    if (ropeDim > 0u) {
        for (short r = 0; r < 2; r++) {
            const uint col = uint(r) * 64u + sg_d * 16u + uint(sn);
            if (uint(r) < nRopeFrags && col < ropeDim) {
                const half4 rv = validSlot
                    ? *(device const half4*)(kPeCache + (size_t)tokJ * ropeDim + col)
                    : half4(0.0h);
                thread mla_hfrag& dst = (r == 0) ? krfR0[f] : krfR1[f];
                STEEL_PRAGMA_UNROLL
                for (short j = 0; j < 4; j++) dst[i * 4 + j] = rv[j];
            }
        }
    }
    if constexpr (KV_MODE == 0u) {
        device const half* src = nullptr;
        if (validSlot) {
            const uint pg = uint(table[tokJ >> 8u]);
            src = pool + ((size_t)pg * 256u + (tokJ & 255u)) * halfRank + poolCol;
        }
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            const half4 v = src ? *(device const half4*)(src + d * 16) : half4(0.0h);
            STEEL_PRAGMA_UNROLL
            for (short j = 0; j < 4; j++) kfF[d][i * 4 + j] = v[j];
        }
    } else if constexpr (KV_MODE == 1u) {
        device const char* qRow = nullptr;
        half rowSc = 0.0h;
        if (validSlot) {
            const uint pg = uint(table[tokJ >> 8u]);
            const uint pageOff = tokJ & 255u;
            device const uchar* pageBase = poolBytes + (size_t)pg * 66048ul;
            rowSc = *((device const half*)(pageBase + 65536ul + (size_t)pageOff * 2ul));
            qRow = (device const char*)(pageBase + (size_t)pageOff * 256ul + poolCol);
        }
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            const half4 v = qRow ? (half4(*(device const char4*)(qRow + d * 16)) * rowSc) : half4(0.0h);
            STEEL_PRAGMA_UNROLL
            for (short j = 0; j < 4; j++) kfF[d][i * 4 + j] = v[j];
        }
    } else {
        device const uchar* qRow = nullptr;
        half2 smQ4 = half2(0.0h);
        if (validSlot) {
            const uint pg = uint(table[tokJ >> 8u]);
            const uint pageOff = tokJ & 255u;
            device const uchar* pageBase = poolBytes + (size_t)pg * 34816ul;
            smQ4 = *((device const half2*)(pageBase + 32768ul) + (size_t)pageOff * 2ul + q4Group);
            qRow = pageBase + (size_t)pageOff * 128ul + (poolCol >> 1u);
        }
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            const half4 v = qRow ? qwg_mla_nax_dequant_q4(qRow, d, smQ4) : half4(0.0h);
            STEEL_PRAGMA_UNROLL
            for (short j = 0; j < 4; j++) kfF[d][i * 4 + j] = v[j];
        }
    }
}

template <bool SPLIT, uint KV_MODE, uint NG>
METAL_FUNC void qw_mla_dsa_nax_attend(
    device const half* qAbs, device const half* kPool, device const half* vPool,
    device const int* kTable, device const int* vTable, device const int* blockList,
    device half* uLatOut, device float2* partML, constant MLADSASparseAttnParams& p,
    device const half* mlaQFull, device const half* kPeCache, device const float* attnSink,
    uint t, uint h0, uint z, uint nSplit, uint sg_h, uint sg_d, uint lane,
    threadgroup float* sPart
) {
    const uint halfRank = MLA_NAX_RANK / 2u;
    const uint seqLen = p.pos0 + t + 1u;
    const bool isDenseStream = (p.topK == 0u);
    const uint startTok = isDenseStream
        ? ((p.windowTokens > 0u && seqLen > p.windowTokens) ? (seqLen - p.windowTokens) : 0u)
        : 0u;
    const uint denseLim = p.topK + p.windowTokens;
    const bool isDensePrefix = !isDenseStream && (seqLen <= denseLim);
    const uint slots = isDenseStream ? (seqLen - startTok) : min(min(seqLen, denseLim), 2560u);
    const float baseScale = (p.softmaxScale > 0.0f) ? p.softmaxScale : rsqrt(float(p.headDim));
    const float scale2 = baseScale * 1.4426950408889634f;
    uint sBegin = 0u, sEnd = slots;
    if (SPLIT) {
        const uint chunk = (((slots + nSplit - 1u) / nSplit) + MLA_NAX_BK - 1u) & ~(MLA_NAX_BK - 1u);
        sBegin = min(slots, z * chunk);
        sEnd = min(slots, sBegin + chunk);
    }

    device const int* rowList = (!isDenseStream && !isDensePrefix)
        ? (blockList + (size_t)t * p.listStride)
        : nullptr;

    const short2 sc = BaseNAXFrag::get_coord();
    const short sm = sc.y, sn = sc.x;
    device const half* pool = (sg_d < 2u) ? kPool : vPool;
    device const uchar* poolBytes = (device const uchar*)pool;
    device const int* table = (sg_d < 2u) ? kTable : vTable;
    const uint poolCol = (sg_d & 1u) * MLA_NAX_DSG + uint(sn);
    const uint q4Group = sg_d & 1u;

    mla_hfrag qf[8];
    {
        device const half* q0 = qAbs + ((size_t)t * p.qHeads + h0 + uint(sm)) * MLA_NAX_RANK
                                + sg_d * MLA_NAX_DSG + uint(sn);
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; i++) {
                const half4 v = *(device const half4*)(q0 + (size_t)i * 8u * MLA_NAX_RANK + d * 16);
                STEEL_PRAGMA_UNROLL
                for (short j = 0; j < 4; j++) qf[d][i * 4 + j] = v[j];
            }
        }
    }
    const uint nRopeFrags = (p.ropeDim > 64u) ? 2u : ((p.ropeDim > 0u) ? 1u : 0u);
    mla_hfrag qrf[2] = {mla_hfrag(0.0h), mla_hfrag(0.0h)};
    if (p.ropeDim > 0u) {
        device const half* qr0 = mlaQFull + (size_t)t * p.qFullStride + p.qRopeOffset
                                 + (size_t)(h0 + uint(sm)) * p.ropeDim;
        STEEL_PRAGMA_UNROLL
        for (short r = 0; r < 2; r++) {
            const uint col = uint(r) * 64u + sg_d * 16u + uint(sn);
            if (uint(r) < nRopeFrags && col < p.ropeDim) {
                STEEL_PRAGMA_UNROLL
                for (short i = 0; i < 2; i++) {
                    const half4 v = *(device const half4*)(qr0 + (size_t)i * 8u * p.ropeDim + col);
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) qrf[r][i * 4 + j] = v[j];
                }
            }
        }
    }

    mla_ffrag oacc[8];
    STEEL_PRAGMA_UNROLL
    for (short d = 0; d < 8; d++) oacc[d] = mla_ffrag(0.0f);
    float mrow[2] = {-1e30f, -1e30f};
    float lrow[2] = {0.0f, 0.0f};
    if (!SPLIT && p.hasSink != 0u) {
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            const float sk = attnSink[h0 + uint(sm + i * 8)] * 1.4426950408889634f;
            if (sk > -1e29f) { mrow[i] = sk; lrow[i] = 1.0f; }
        }
    }

    for (uint s0 = sBegin; s0 < sEnd; s0 += MLA_NAX_BK) {
        mla_hfrag kf[2][8];
        mla_hfrag krf[2][2] = {{mla_hfrag(0.0h), mla_hfrag(0.0h)}, {mla_hfrag(0.0h), mla_hfrag(0.0h)}};
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; i++) {
                const uint slot = s0 + uint(f * 16 + sm + i * 8);
                const bool validSlot = (slot < sEnd);
                const uint tokJ = validSlot
                    ? (isDenseStream ? (startTok + slot)
                                     : (isDensePrefix ? slot : min(uint(max(rowList[slot], 0)), seqLen - 1u)))
                    : 0u;
                qw_mla_dsa_nax_load_slot<KV_MODE>(
                    pool, poolBytes, table, kPeCache, p.ropeDim, nRopeFrags, halfRank,
                    poolCol, q4Group, sg_d, sn, f, i, validSlot, tokJ,
                    kf[f], krf[0], krf[1]);
            }
        }

        mla_ffrag s[2] = {mla_ffrag(0.0f), mla_ffrag(0.0f)};
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            BaseNAXFrag::mma(s[0], s[1], qf[d], metal::false_type{},
                             kf[0][d], kf[1][d], metal::true_type{});
        }
        if (p.ropeDim > 0u) {
            for (uint r = 0u; r < nRopeFrags; ++r) {
                BaseNAXFrag::mma(s[0], s[1], qrf[r], metal::false_type{},
                                 krf[r][0], krf[r][1], metal::true_type{});
            }
        }
        if (s0 > sBegin) threadgroup_barrier(mem_flags::mem_threadgroup);
        threadgroup float* part = sPart + sg_h * (4u * 16u * 32u);
        STEEL_PRAGMA_UNROLL
        for (short e = 0; e < 16; e++) part[(sg_d * 16u + uint(e)) * 32u + lane] = s[e >> 3][e & 7];
        threadgroup_barrier(mem_flags::mem_threadgroup);
        STEEL_PRAGMA_UNROLL
        for (short e = 0; e < 16; e++) {
            float v = part[uint(e) * 32u + lane];
            v += part[(16u + uint(e)) * 32u + lane];
            v += part[(32u + uint(e)) * 32u + lane];
            v += part[(48u + uint(e)) * 32u + lane];
            s[e >> 3][e & 7] = v;
        }

        float mnew[2] = {mrow[0], mrow[1]};
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short loc = 0; loc < 8; loc++) {
                const uint slot = s0 + uint(f * 16 + sn + (loc & 3));
                const float x = (slot < sEnd) ? s[f][loc] * scale2 : -1e30f;
                s[f][loc] = x;
                mnew[loc >> 2] = max(mnew[loc >> 2], x);
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(1)));
            mnew[i] = max(mnew[i], simd_shuffle_xor(mnew[i], ushort(8)));
        }

        mla_hfrag pf[2];
        float psum[2] = {0.0f, 0.0f};
        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short loc = 0; loc < 8; loc++) {
                const float x = fast::exp2(s[f][loc] - mnew[loc >> 2]);
                pf[f][loc] = half(x);
                psum[loc >> 2] += x;
            }
        }
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; i++) {
            psum[i] += simd_shuffle_xor(psum[i], ushort(1));
            psum[i] += simd_shuffle_xor(psum[i], ushort(8));
            const bool grew = (mnew[i] > mrow[i]) && (mrow[i] > -1e29f);
            const float corr = grew ? fast::exp2(mrow[i] - mnew[i]) : 1.0f;
            lrow[i] = lrow[i] * corr + psum[i];
            if (grew) {
                STEEL_PRAGMA_UNROLL
                for (short d = 0; d < 8; d++) {
                    STEEL_PRAGMA_UNROLL
                    for (short j = 0; j < 4; j++) oacc[d][i * 4 + j] *= corr;
                }
            }
            mrow[i] = mnew[i];
        }

        STEEL_PRAGMA_UNROLL
        for (short f = 0; f < 2; f++) {
            STEEL_PRAGMA_UNROLL
            for (short pr = 0; pr < 4; pr++) {
                BaseNAXFrag::mma(oacc[2 * pr], oacc[2 * pr + 1], pf[f], metal::false_type{},
                                 kf[f][2 * pr], kf[f][2 * pr + 1], metal::false_type{});
            }
        }
    }

    STEEL_PRAGMA_UNROLL
    for (short i = 0; i < 2; i++) {
        const float inv = (lrow[i] > 0.0f) ? (1.0f / lrow[i]) : 0.0f;
        const size_t rowIdx = SPLIT ? ((size_t)t * nSplit + z) * p.qHeads + h0 + uint(sm + i * 8)
                                    : (size_t)t * p.qHeads + h0 + uint(sm + i * 8);
        if (SPLIT && sg_d == 0u && sn == 0) partML[rowIdx] = float2(mrow[i], lrow[i]);
        device half* dst = uLatOut + rowIdx * MLA_NAX_RANK + sg_d * MLA_NAX_DSG + uint(sn);
        STEEL_PRAGMA_UNROLL
        for (short d = 0; d < 8; d++) {
            *(device half4*)(dst + d * 16) = half4(half(oacc[d][i * 4 + 0] * inv), half(oacc[d][i * 4 + 1] * inv),
                                                   half(oacc[d][i * 4 + 2] * inv), half(oacc[d][i * 4 + 3] * inv));
        }
    }
}
