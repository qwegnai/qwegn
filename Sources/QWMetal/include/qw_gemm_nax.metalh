// qw_gemm_nax.metalh — Shared NAX/MPP GEMM, split-activation, and grouped MoE
// templates across HQ4_G32, AQ<BITS, GROUP>, and SHVQ<BITS, GROUP>.
#pragma once
#include <metal_stdlib>
#include <metal_simdgroup>
#include <MetalPerformancePrimitives/MetalPerformancePrimitives.h>
#if !defined(__ENVIRONMENT_OS_VERSION_MIN_REQUIRED__) || __ENVIRONMENT_OS_VERSION_MIN_REQUIRED__ < 260200
#error "NAX cooperative_tensor kernels require -mmacosx-version-min=26.2 or newer (Apple MPP operand_index ABI)."
#endif
#include "mlx/backend/metal/kernels/utils.h"
#include "mlx/backend/metal/kernels/steel/gemm/gemm.h"
#include "mlx/backend/metal/kernels/steel/gemm/nax.h"
#include "mlx/backend/metal/kernels/steel/gemm/loader.h"
#include "qw_dequant.metalh"
#include "qw_dequant_shvq.metalh"
#include "qw_moe_tile.metalh"
#include "qw_geometry_constants.metalh"

using namespace metal;
using namespace mlx::steel;

struct QWGemmGroupedParams {
    uint experts;
    uint n;
    uint k;
    uint blocksPerRow;
    uint rowTiles;
    uint colTiles;
};

/// Unpacks two 4-weight halves of a quant block via magic-bias FMA for NAX fragments.
template <int BITS>
METAL_FUNC void qwg_aq_frag8(device const char* gp, uint bitOffset,
                             thread half4 &lo, thread half4 &hi) {
    const half2 sb = *(device const half2*)gp;
    const half2 s2 = half2(sb.x);
    const half2 b2 = half2(sb.y);
    const half2 kBias = half2(-1024.0h);
    device const uchar* p = (device const uchar*)(gp + 4);
    const uint byteOff = bitOffset >> 3u;
    if constexpr (BITS == 2) {
        const ushort2 raw = ushort2(ushort(p[byteOff]), ushort(p[byteOff + 4u]));
        const half2 c0 = as_type<half2>((raw & ushort2(0x0003u)) | ushort2(0x6400u)) + kBias;
        const half2 c1 = as_type<half2>(((raw >> 2u) & ushort2(0x0003u)) | ushort2(0x6400u)) + kBias;
        const half2 c2 = as_type<half2>(((raw >> 4u) & ushort2(0x0003u)) | ushort2(0x6400u)) + kBias;
        const half2 c3 = as_type<half2>((raw >> 6u) | ushort2(0x6400u)) + kBias;
        const half2 w0 = fma(c0, s2, b2), w1 = fma(c1, s2, b2);
        const half2 w2 = fma(c2, s2, b2), w3 = fma(c3, s2, b2);
        lo = half4(w0.x, w1.x, w2.x, w3.x);
        hi = half4(w0.y, w1.y, w2.y, w3.y);
    } else if constexpr (BITS == 3) {
        const uint bOffHi = (bitOffset + 48u) >> 3u;
        const uint vLo = (uint(p[byteOff]) | (uint(p[byteOff + 1u]) << 8u)) >> (bitOffset & 7u);
        const uint vHi = (uint(p[bOffHi]) | (uint(p[bOffHi + 1u]) << 8u)) >> ((bitOffset + 48u) & 7u);
        const ushort2 raw = ushort2(ushort(vLo), ushort(vHi));
        const half2 c0 = as_type<half2>((raw & ushort2(0x0007u)) | ushort2(0x6400u)) + kBias;
        const half2 c1 = as_type<half2>(((raw >> 3u) & ushort2(0x0007u)) | ushort2(0x6400u)) + kBias;
        const half2 c2 = as_type<half2>(((raw >> 6u) & ushort2(0x0007u)) | ushort2(0x6400u)) + kBias;
        const half2 c3 = as_type<half2>(((raw >> 9u) & ushort2(0x0007u)) | ushort2(0x6400u)) + kBias;
        const half2 w0 = fma(c0, s2, b2), w1 = fma(c1, s2, b2);
        const half2 w2 = fma(c2, s2, b2), w3 = fma(c3, s2, b2);
        lo = half4(w0.x, w1.x, w2.x, w3.x);
        hi = half4(w0.y, w1.y, w2.y, w3.y);
    } else if constexpr (BITS == 4) {
        const ushort2 raw = ushort2(*(device const ushort*)(p + byteOff),
                                    *(device const ushort*)(p + byteOff + 8u));
        const half2 c0 = as_type<half2>((raw & ushort2(0x000Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c1 = as_type<half2>(((raw >> 4u) & ushort2(0x000Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c2 = as_type<half2>(((raw >> 8u) & ushort2(0x000Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c3 = as_type<half2>((raw >> 12u) | ushort2(0x6400u)) + kBias;
        const half2 w0 = fma(c0, s2, b2), w1 = fma(c1, s2, b2);
        const half2 w2 = fma(c2, s2, b2), w3 = fma(c3, s2, b2);
        lo = half4(w0.x, w1.x, w2.x, w3.x);
        hi = half4(w0.y, w1.y, w2.y, w3.y);
    } else if constexpr (BITS == 6) {
        const uint uLo = uint(p[byteOff]) | (uint(p[byteOff + 1u]) << 8u) | (uint(p[byteOff + 2u]) << 16u);
        const uint uHi = uint(p[byteOff + 12u]) | (uint(p[byteOff + 13u]) << 8u) | (uint(p[byteOff + 14u]) << 16u);
        const ushort2 r01 = ushort2(ushort(uLo), ushort(uHi));
        const ushort2 r23 = ushort2(ushort(uLo >> 12u), ushort(uHi >> 12u));
        const half2 c0 = as_type<half2>((r01 & ushort2(0x003Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c1 = as_type<half2>(((r01 >> 6u) & ushort2(0x003Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c2 = as_type<half2>((r23 & ushort2(0x003Fu)) | ushort2(0x6400u)) + kBias;
        const half2 c3 = as_type<half2>(((r23 >> 6u) & ushort2(0x003Fu)) | ushort2(0x6400u)) + kBias;
        const half2 w0 = fma(c0, s2, b2), w1 = fma(c1, s2, b2);
        const half2 w2 = fma(c2, s2, b2), w3 = fma(c3, s2, b2);
        lo = half4(w0.x, w1.x, w2.x, w3.x);
        hi = half4(w0.y, w1.y, w2.y, w3.y);
    } else {
        (void)s2; (void)b2; (void)kBias;
        const half4 cLo = half4(as_type<uchar4>(*(device const uint*)(p + byteOff)));
        const half4 cHi = half4(as_type<uchar4>(*(device const uint*)(p + byteOff + 16u)));
        lo = fma(cLo, half4(sb.x), half4(sb.y));
        hi = fma(cHi, half4(sb.x), half4(sb.y));
    }
}

template <short TN, short TK, int AQ_BITS, int AQ_GROUP, bool IS_SHVQ, bool HAS_SHVQ_TG_LUT, bool CHECK_BOUNDS>
METAL_FUNC void qwg_nax_load_btile(thread NAXTile<half, TN, TK>& Btile,
                                   const device Block_HQ4_G32* w_tile,
                                   int K_g, uint w_sub, uint shift,
                                   const device char* aqGroupBase,
                                   uint aqColInGroup, uint aqBitInGroup, uint aqRowBytes,
                                   int tn, int tgp_bn, short2 sc,
                                   threadgroup const ushort4* shvqLut16) {
    const_for_loop<0, TN, 1>([&](auto idx_row) {
        thread auto& f0 = Btile.template frag_at<idx_row.value, 0>();
        thread auto& f1 = Btile.template frag_at<idx_row.value, 1>();
        STEEL_PRAGMA_UNROLL
        for (short i = 0; i < 2; ++i) {
            const int r_tile = tn + idx_row.value * 16 + int(sc.y) + int(i) * 8;
            if (!CHECK_BOUNDS || r_tile < tgp_bn) {
                if constexpr (AQ_BITS == 0) {
                    const device Block_HQ4_G32& blk = w_tile[static_cast<int64_t>(r_tile) * K_g];
                    const half2 dm = *(const device half2*)(&blk);
                    const half2 s2 = half2(dm.x), b2 = half2(dm.y);
                    const ushort2 raw0 = as_type<ushort2>(blk.qs[w_sub]) >> shift;
                    const ushort2 raw1 = as_type<ushort2>(blk.qs[2u + w_sub]) >> shift;
                    const half2 w01 = fma(as_type<half2>((raw0 & ushort2(0x000Fu)) | ushort2(0x6400u)), s2, b2);
                    const half2 w23 = fma(as_type<half2>(((raw0 >> 4) & ushort2(0x000Fu)) | ushort2(0x6400u)), s2, b2);
                    const half2 w45 = fma(as_type<half2>((raw1 & ushort2(0x000Fu)) | ushort2(0x6400u)), s2, b2);
                    const half2 w67 = fma(as_type<half2>(((raw1 >> 4) & ushort2(0x000Fu)) | ushort2(0x6400u)), s2, b2);
                    f0[i * 4 + 0] = w01.x; f0[i * 4 + 1] = w01.y;
                    f0[i * 4 + 2] = w23.x; f0[i * 4 + 3] = w23.y;
                    f1[i * 4 + 0] = w45.x; f1[i * 4 + 1] = w45.y;
                    f1[i * 4 + 2] = w67.x; f1[i * 4 + 3] = w67.y;
                } else {
                    const device char* gp = aqGroupBase + static_cast<int64_t>(r_tile) * aqRowBytes;
                    half4 lo, hi;
                    if constexpr (IS_SHVQ) {
                        qwg_shvq_frag8_tg<AQ_BITS, AQ_BITS == 4 || AQ_BITS == 15, HAS_SHVQ_TG_LUT>(
                            gp, aqColInGroup, shvqLut16, lo, hi);
                    } else {
                        (void)shvqLut16;
                        qwg_aq_frag8<AQ_BITS>(gp, aqBitInGroup, lo, hi);
                    }
                    f0[i * 4 + 0] = lo.x; f0[i * 4 + 1] = lo.y;
                    f0[i * 4 + 2] = lo.z; f0[i * 4 + 3] = lo.w;
                    f1[i * 4 + 0] = hi.x; f1[i * 4 + 1] = hi.y;
                    f1[i * 4 + 2] = hi.z; f1[i * 4 + 3] = hi.w;
                }
            } else {
                f0[i * 4 + 0] = half(0); f0[i * 4 + 1] = half(0);
                f0[i * 4 + 2] = half(0); f0[i * 4 + 3] = half(0);
                f1[i * 4 + 0] = half(0); f1[i * 4 + 1] = half(0);
                f1[i * 4 + 2] = half(0); f1[i * 4 + 3] = half(0);
            }
        }
    });
}

template <typename T, typename U = T, const bool aligned_N = false,
          const int BM = 64, const int BK = 64, const int BN = 64,
          const int WM = 2, const int WN = 2, bool store32 = false, bool splitGdn = false,
          bool gatherA = false, const int AQ_BITS = 0, const int AQ_GROUP = 0,
          const bool IS_SHVQ = false, const bool HAS_SHVQ_TG_LUT = false>
METAL_FUNC void qmm_t_nax_tgp_dual_impl(
    const device char* w, const device T* x, device U* y, device float* y32,
    threadgroup T* Ws, int K, int N, int M,
    uint3 tid [[threadgroup_position_in_grid]],
    uint lid [[thread_index_in_threadgroup]],
    uint simd_gid [[simdgroup_index_in_threadgroup]],
    uint simd_lid [[thread_index_in_simdgroup]],
    device U* z16 = nullptr,
    const device int32_t* sortedTok = nullptr,
    threadgroup const ushort4* shvqLut16 = nullptr) {
    (void)Ws; (void)lid; (void)simd_lid;
    const int K_g = K / 32, y_row = tid.y * BM, y_col = tid.x * BN;
    const int gdnQKV = int(QW_GDN_QKV_CH), gdnZ = int(QW_GDN_Z_CH), gdnQKVZ = gdnQKV + gdnZ;
    const int gdnTotalN = gdnQKVZ + 2 * int(QW_GDN_V_HEADS);
    const bool need_store32 = store32 && (N != gdnTotalN || (y_col + BN > gdnQKVZ));
    const int y32Stride = splitGdn ? max(1, N - gdnQKVZ) : N;
    const int y32Col = splitGdn ? (y_col - gdnQKVZ) : y_col;

    const device Block_HQ4_G32* w_tile =
        (AQ_BITS == 0) ? (const device Block_HQ4_G32*)w + static_cast<int64_t>(y_col) * K_g : nullptr;
    if constexpr (!gatherA) x += y_row * static_cast<int64_t>(K);
    if constexpr (!splitGdn) y += y_row * static_cast<int64_t>(N) + y_col;
    if (need_store32 && y32 != nullptr) y32 += y_row * static_cast<int64_t>(y32Stride) + y32Col;

    constexpr short SM = BM / WM, SN = BN / WN, SK = 32;
    constexpr short TM = SM / 16, TN = SN / 16, TK = SK / 16;
    const short tm = SM * (simd_gid / WN), tn = SN * (simd_gid % WN);
    const short sgp_sm = min(int(SM), M - (y_row + tm));
    const bool is_unaligned_sm = (sgp_sm != SM);
    const short sgp_sn = aligned_N ? SN : min(int(SN), N - (y_col + tn));
    const short tgp_bn = aligned_N ? BN : min(BN, int(N - y_col));
    const bool is_unaligned_bn = aligned_N ? false : (tgp_bn != BN);
    if (sgp_sm <= 0 || sgp_sn <= 0) return;

    NAXTile<float, TM, TN> Dtile;
    Dtile.clear();
    if constexpr (!gatherA) x += static_cast<int64_t>(tm) * K;
    const short2 sc = BaseNAXFrag::get_coord();
    const ushort w_sub = ushort(sc.x >> 3), shift = ushort((sc.x & 4) << 1);
    constexpr uint aqGroupBytes = AQ_BITS > 0
        ? (IS_SHVQ ? qwg_shvq_group_bytes(AQ_BITS, AQ_GROUP) : (uint(AQ_GROUP * AQ_BITS / 8) + 4u))
        : 0u;
    const uint aqRowBytes = AQ_BITS > 0 ? uint(K / AQ_GROUP) * aqGroupBytes : 0u;
    const device char* w_aq_tile = (AQ_BITS > 0) ? (w + static_cast<int64_t>(y_col) * aqRowBytes) : nullptr;

    const device T* x_rows[TM * 2];
    if constexpr (gatherA) {
        STEEL_PRAGMA_UNROLL
        for (short m = 0; m < TM; ++m) {
            STEEL_PRAGMA_UNROLL
            for (short i = 0; i < 2; ++i) {
                const int r = y_row + int(tm) + int(m) * 16 + int(sc.y) + int(i) * 8;
                const int tok = (r < M) ? sortedTok[r] : -1;
                x_rows[m * 2 + i] = (tok >= 0) ? (x + static_cast<int64_t>(tok) * K + int(sc.x)) : nullptr;
            }
        }
    }

    dispatch_bool(!is_unaligned_sm, [&](auto kAlignedM) {
        dispatch_bool(aligned_N || !is_unaligned_bn, [&](auto kAlignedN) {
            STEEL_PRAGMA_NO_UNROLL
            for (int k = 0; k < K; k += SK) {
                NAXTile<T, TM, TK> Atile;
                NAXTile<T, TN, TK> Btile;
                if constexpr (gatherA) {
                    const_for_loop<0, TM, 1>([&](auto idx_row) {
                        constexpr short m = idx_row.value;
                        thread auto& a0 = Atile.template frag_at<m, 0>();
                        thread auto& a1 = Atile.template frag_at<m, 1>();
                        STEEL_PRAGMA_UNROLL
                        for (short i = 0; i < 2; ++i) {
                            const device T* xr = x_rows[m * 2 + i];
                            if (xr != nullptr) {
                                const vec<T, 4> v0 = *(const device vec<T, 4>*)(xr + k);
                                const vec<T, 4> v1 = *(const device vec<T, 4>*)(xr + k + 16);
                                a0[i * 4 + 0] = v0.x; a0[i * 4 + 1] = v0.y; a0[i * 4 + 2] = v0.z; a0[i * 4 + 3] = v0.w;
                                a1[i * 4 + 0] = v1.x; a1[i * 4 + 1] = v1.y; a1[i * 4 + 2] = v1.z; a1[i * 4 + 3] = v1.w;
                            } else {
                                a0[i * 4 + 0] = T(0); a0[i * 4 + 1] = T(0); a0[i * 4 + 2] = T(0); a0[i * 4 + 3] = T(0);
                                a1[i * 4 + 0] = T(0); a1[i * 4 + 1] = T(0); a1[i * 4 + 2] = T(0); a1[i * 4 + 3] = T(0);
                            }
                        }
                    });
                } else if constexpr (kAlignedM.value) {
                    Atile.load(x, K);
                } else {
                    Atile.load_safe(x, K, short2(SK, sgp_sm));
                }

                const uint aqGroupIndex = AQ_BITS > 0 ? (uint(k) / uint(AQ_GROUP)) : 0u;
                const uint aqColInGroup = AQ_BITS > 0 ? ((uint(k) & uint(AQ_GROUP - 1)) + uint(sc.x)) : 0u;
                const uint aqBitInGroup = aqColInGroup * uint(AQ_BITS);
                const device char* aqGroupBase = AQ_BITS > 0
                    ? (w_aq_tile + static_cast<int64_t>(aqGroupIndex) * aqGroupBytes)
                    : nullptr;
                qwg_nax_load_btile<TN, TK, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_SHVQ_TG_LUT, !kAlignedN.value>(
                    Btile, w_tile, K_g, w_sub, shift, aqGroupBase, aqColInGroup, aqBitInGroup,
                    aqRowBytes, int(tn), int(tgp_bn), sc, shvqLut16);

                tile_matmad_nax(Dtile, Atile, metal::bool_constant<false>{}, Btile, metal::bool_constant<true>{});
                if constexpr (!gatherA) x += SK;
                if constexpr (AQ_BITS == 0) w_tile += 1;
            }

            if constexpr (splitGdn) {
                if (y_col < gdnQKV) {
                    device U* qkv_dst = y + (y_row + tm) * static_cast<int64_t>(gdnQKV) + (y_col + tn);
                    if constexpr (kAlignedM.value) Dtile.store(qkv_dst, gdnQKV);
                    else Dtile.store_safe(qkv_dst, gdnQKV, short2(sgp_sn, sgp_sm));
                } else if (y_col < gdnQKVZ) {
                    device U* z_dst = z16 + (y_row + tm) * static_cast<int64_t>(gdnZ) + (y_col - gdnQKV + tn);
                    if constexpr (kAlignedM.value) Dtile.store(z_dst, gdnZ);
                    else Dtile.store_safe(z_dst, gdnZ, short2(sgp_sn, sgp_sm));
                } else if (need_store32 && y32 != nullptr) {
                    device float* y32_dst = y32 + static_cast<int64_t>(tm) * y32Stride + tn;
                    if constexpr (kAlignedM.value && kAlignedN.value) Dtile.store(y32_dst, y32Stride);
                    else Dtile.store_safe(y32_dst, y32Stride, short2(sgp_sn, sgp_sm));
                }
            } else {
                device U* y_dst = y + static_cast<int64_t>(tm) * N + tn;
                device float* y32_dst = y32 + static_cast<int64_t>(tm) * y32Stride + tn;
                if constexpr (kAlignedM.value && kAlignedN.value) {
                    Dtile.store(y_dst, N);
                    if constexpr (store32) if (need_store32 && y32 != nullptr) Dtile.store(y32_dst, y32Stride);
                } else if (kAlignedM.value && sgp_sn == SN) {
                    Dtile.store(y_dst, N);
                    if constexpr (store32) if (need_store32 && y32 != nullptr) Dtile.store(y32_dst, y32Stride);
                } else {
                    Dtile.store_safe(y_dst, N, short2(sgp_sn, sgp_sm));
                    if constexpr (store32) if (need_store32 && y32 != nullptr) Dtile.store_safe(y32_dst, y32Stride, short2(sgp_sn, sgp_sm));
                }
            }
        });
    });
}

template <const int BM, const int WM, const int WN,
          const int AQ_BITS = 0, const int AQ_GROUP = 0,
          const bool IS_SHVQ = false, const bool HAS_TG_LUT = false,
          const bool splitLo = true, typename OutT = float>
METAL_FUNC void qmm_t_nax_split_impl(
    const device char* w, const device half* xh, const device half* xl, device OutT* y,
    int K, int N, int M, uint3 tid, uint simd_gid,
    threadgroup const ushort4* shvqLut16 = nullptr) {
    constexpr int BN = 64;
    constexpr short SM = BM / WM, SN = BN / WN;
    constexpr short TM = SM / 16, TN = SN / 16, TK = 2;
    const int K_g = K / 32, y_row = int(tid.y) * BM, y_col = int(tid.x) * BN;
    const short tm = SM * short(simd_gid / WN), tn = SN * short(simd_gid % WN);
    const short sgp_sm = short(min(int(SM), M - (y_row + int(tm))));
    const short sgp_sn = (AQ_BITS == 0) ? SN : short(min(int(SN), N - (y_col + int(tn))));
    const short tgp_bn = (AQ_BITS == 0) ? BN : short(min(BN, N - y_col));
    if (sgp_sm <= 0 || (AQ_BITS > 0 && sgp_sn <= 0)) return;

    xh += y_row * static_cast<int64_t>(K);
    if constexpr (splitLo) xl += y_row * static_cast<int64_t>(K);
    y += y_row * static_cast<int64_t>(N) + y_col;
    const device Block_HQ4_G32* wt =
        (AQ_BITS == 0) ? ((const device Block_HQ4_G32*)w + static_cast<int64_t>(y_col) * K_g) : nullptr;
    constexpr uint aqGroupBytes = AQ_BITS > 0
        ? (IS_SHVQ ? qwg_shvq_group_bytes(AQ_BITS, AQ_GROUP) : (uint(AQ_GROUP * AQ_BITS / 8) + 4u))
        : 0u;
    constexpr uint slicesPerGroup = AQ_BITS > 0 ? (uint(AQ_GROUP) >> 5u) : 1u;
    const uint aqRowBytes = AQ_BITS > 0 ? uint(K / AQ_GROUP) * aqGroupBytes : 0u;
    const device char* w_aq_tile = (AQ_BITS > 0) ? (w + static_cast<int64_t>(y_col) * aqRowBytes) : nullptr;

    const short2 sc = BaseNAXFrag::get_coord();
    const ushort w_sub = ushort(sc.x >> 3), shift = ushort((sc.x & 4) << 1);
    NAXTile<float, TM, TN> Dtile;
    Dtile.clear();
    xh += tm * K;
    if constexpr (splitLo) xl += tm * K;

    dispatch_bool(sgp_sm == SM, [&](auto kAlignedM) {
        dispatch_bool(AQ_BITS == 0 || tgp_bn == BN, [&](auto kAlignedN) {
            #pragma unroll 4
            for (int g = 0; g < K_g; ++g) {
                NAXTile<half, TM, TK> Ah, Al;
                NAXTile<half, TN, TK> Btile;
                if constexpr (kAlignedM.value) {
                    Ah.load(xh, K);
                    if constexpr (splitLo) Al.load(xl, K);
                } else {
                    Ah.load_safe(xh, K, short2(32, sgp_sm));
                    if constexpr (splitLo) Al.load_safe(xl, K, short2(32, sgp_sm));
                }
                const uint groupIdx = AQ_BITS > 0 ? (uint(g) / slicesPerGroup) : 0u;
                const uint colInGroup = AQ_BITS > 0 ? (((uint(g) & (slicesPerGroup - 1u)) << 5u) + uint(sc.x)) : 0u;
                const uint bitInGroup = colInGroup * uint(AQ_BITS);
                const device char* aqGroupBase = AQ_BITS > 0
                    ? (w_aq_tile + static_cast<int64_t>(groupIdx) * aqGroupBytes)
                    : nullptr;
                qwg_nax_load_btile<TN, TK, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG_LUT, !kAlignedN.value>(
                    Btile, wt, K_g, w_sub, shift, aqGroupBase, colInGroup, bitInGroup,
                    aqRowBytes, int(tn), int(tgp_bn), sc, shvqLut16);
                tile_matmad_nax(Dtile, Ah, metal::bool_constant<false>{}, Btile, metal::bool_constant<true>{});
                if constexpr (splitLo) tile_matmad_nax(Dtile, Al, metal::bool_constant<false>{}, Btile, metal::bool_constant<true>{});
                xh += 32;
                if constexpr (splitLo) xl += 32;
                if constexpr (AQ_BITS == 0) wt += 1;
            }
            if constexpr (kAlignedM.value && kAlignedN.value) Dtile.store(y + tm * N + tn, N);
            else Dtile.store_safe(y + tm * N + tn, N, short2(sgp_sn, sgp_sm));
        });
    });
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false, bool HAS_TG = false>
METAL_FUNC void qwg_gemm_h16_mode_dispatch(const device char* w, const device half* x,
                                           device half* y16, device float* y32,
                                           uint M, uint N, uint K,
                                           uint3 tg, uint lid, uint simd_gid, uint simd_lid,
                                           threadgroup const ushort4* shvqLut16 = nullptr) {
    const uint mode = (M >> 29u) & 3u;
    const int realM = int(M & 0x1FFFFFFFu);
    if (mode == 1u) {
        qmm_t_nax_tgp_dual_impl<half, half, false, 16, 64, 128, 1, 4, false, false, false,
                                AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(
            w, x, y16, y32, nullptr, int(K), int(N), realM, tg, lid, simd_gid, simd_lid,
            nullptr, nullptr, shvqLut16);
    } else if (mode == 2u) {
        qmm_t_nax_tgp_dual_impl<half, half, false, 32, 64, 64, 2, 2, false, false, false,
                                AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(
            w, x, y16, y32, nullptr, int(K), int(N), realM, tg, lid, simd_gid, simd_lid,
            nullptr, nullptr, shvqLut16);
    } else {
        qmm_t_nax_tgp_dual_impl<half, half, false, 64, 64, 64, 2, 2, false, false, false,
                                AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(
            w, x, y16, y32, nullptr, int(K), int(N), realM, tg, lid, simd_gid, simd_lid,
            nullptr, nullptr, shvqLut16);
    }
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false, bool HAS_TG = false, typename OutT>
METAL_FUNC void qwg_gemm_nax_split_mode_dispatch(const device char* w, const device half* xh,
                                                 const device half* xl, device OutT* y,
                                                 int K, int N, int M, uint mode,
                                                 uint3 tid, uint simd_gid,
                                                 threadgroup const ushort4* shvqLut16 = nullptr) {
    if (mode == 1u) {
        qmm_t_nax_split_impl<16, 1, 4, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, false, OutT>(
            w, xh, xl, y, K, N, M, tid, simd_gid, shvqLut16);
    } else if (mode == 2u) {
        qmm_t_nax_split_impl<32, 2, 2, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, false, OutT>(
            w, xh, xl, y, K, N, M, tid, simd_gid, shvqLut16);
    } else {
        qmm_t_nax_split_impl<64, 2, 2, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, false, OutT>(
            w, xh, xl, y, K, N, M, tid, simd_gid, shvqLut16);
    }
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false, bool HAS_TG = false>
METAL_FUNC void qwg_gemm_nax_f32_dispatch(const device char* w, const device half* xh,
                                          const device half* xl, device float* y32,
                                          uint M, uint N, uint K, uint3 tg, uint simd_gid,
                                          threadgroup const ushort4* shvqLut16 = nullptr) {
    const uint mode = (M >> 29u) & 3u;
    const int realM = int(M & 0x0FFFFFFFu);
    if ((M & 0x80000000u) != 0u) {
        qwg_gemm_nax_split_mode_dispatch<AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, half>(
            w, xh, xl, (device half*)y32, int(K), int(N), realM, mode, tg, simd_gid, shvqLut16);
    } else if ((M & 0x10000000u) != 0u) {
        qwg_gemm_nax_split_mode_dispatch<AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, bfloat>(
            w, xh, xl, (device bfloat*)y32, int(K), int(N), realM, mode, tg, simd_gid, shvqLut16);
    } else {
        qwg_gemm_nax_split_mode_dispatch<AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, float>(
            w, xh, xl, y32, int(K), int(N), realM, mode, tg, simd_gid, shvqLut16);
    }
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false>
METAL_FUNC size_t qwg_nax_row_bytes(constant QWGemmGroupedParams& p) {
    if constexpr (AQ_BITS == 0) {
        return size_t(p.blocksPerRow) * sizeof(Block_HQ4_G32);
    } else if constexpr (IS_SHVQ) {
        return (size_t(p.k) / uint(AQ_GROUP)) * size_t(qwg_shvq_group_bytes(AQ_BITS, AQ_GROUP));
    } else {
        return (size_t(p.k) / uint(AQ_GROUP)) * (size_t(AQ_GROUP * AQ_BITS) / 8u + 4u);
    }
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false, bool HAS_TG = false>
METAL_FUNC void qwg_moe_nax_gemm_body(device const char* w, device const half* x, device half* y,
                                      device const int32_t* expertOff, device const int32_t* tileE,
                                      device const int32_t* tileR, device const int32_t* tileCount,
                                      constant QWGemmGroupedParams& p, uint tileBlock,
                                      device const int32_t* sortedTok, uint hasGather,
                                      device const char* coldW,
                                      uint3 tg, uint lid, uint simd_gid, uint simd_lid,
                                      threadgroup const ushort4* tgLut = nullptr) {
    const uint t = tg.y + ((tileBlock >> 8) & 0x7FFFFFu);
    if (int(t) >= tileCount[0]) return;
    const uint e = uint(tileE[t]);
    const int rowBase = int(expertOff[e]), rowCount = int(expertOff[e + 1]) - rowBase;
    const uint residentE = p.experts >> 16u;
    const bool isCold = (residentE > 0u) && (e >= residentE);
    if (((tileBlock & 0x40u) != 0u && isCold) || ((tileBlock & 0x80u) != 0u && !isCold)) return;
    const size_t rowBytes = qwg_nax_row_bytes<AQ_BITS, AQ_GROUP, IS_SHVQ>(p);
    const uint wExp = isCold ? (e - residentE) : e;
    device const char* we = (isCold ? coldW : w) + size_t(wExp) * size_t(p.n) * rowBytes;
    device half* ye = y + size_t(rowBase) * size_t(p.n);
    int bm; uint tidY;
    qw_moe_decode_tile(tileR[t], rowCount, int(tileBlock & 0x3Fu), bm, tidY);
    const uint3 tid = uint3(tg.x, tidY, 0);
    if (hasGather != 0u) {
        device const int32_t* st = sortedTok + rowBase;
        if (bm == 16) qmm_t_nax_tgp_dual_impl<half, half, true, 16, 64, 64, 1, 4, false, false, true, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, x, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, st, tgLut);
        else if (bm == 32) qmm_t_nax_tgp_dual_impl<half, half, true, 32, 64, 64, 2, 2, false, false, true, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, x, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, st, tgLut);
        else qmm_t_nax_tgp_dual_impl<half, half, true, 64, 64, 64, 2, 2, false, false, true, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, x, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, st, tgLut);
    } else {
        device const half* xe = x + size_t(rowBase) * size_t(p.k);
        if (bm == 16) qmm_t_nax_tgp_dual_impl<half, half, true, 16, 64, 64, 1, 4, false, false, false, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, xe, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, nullptr, tgLut);
        else if (bm == 32) qmm_t_nax_tgp_dual_impl<half, half, true, 32, 64, 64, 2, 2, false, false, false, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, xe, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, nullptr, tgLut);
        else qmm_t_nax_tgp_dual_impl<half, half, true, 64, 64, 64, 2, 2, false, false, false, AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG>(we, xe, ye, nullptr, nullptr, int(p.k), int(p.n), rowCount, tid, lid, simd_gid, simd_lid, nullptr, nullptr, tgLut);
    }
}

template <int AQ_BITS = 0, int AQ_GROUP = 0, bool IS_SHVQ = false, bool HAS_TG = false>
METAL_FUNC void qwg_moe_nax_split_f32_body(device const char* w, device const half* xh, device const half* xl,
                                           device float* y32, device const int32_t* expertOff,
                                           device const int32_t* tileE, device const int32_t* tileR,
                                           device const int32_t* tileCount, constant QWGemmGroupedParams& p,
                                           uint tileBlock, device const char* coldW,
                                           uint3 tg, uint simd_gid, threadgroup const ushort4* tgLut = nullptr) {
    const uint t = tg.y + ((tileBlock >> 8) & 0x7FFFFFu);
    if (int(t) >= tileCount[0]) return;
    const uint e = uint(tileE[t]);
    const int rowBase = int(expertOff[e]), rowCount = int(expertOff[e + 1]) - rowBase;
    const uint residentE = p.experts >> 16u;
    const bool isCold = (residentE > 0u) && (e >= residentE);
    if (((tileBlock & 0x40u) != 0u && isCold) || ((tileBlock & 0x80u) != 0u && !isCold)) return;
    int bm; uint tidY;
    qw_moe_decode_tile(tileR[t], rowCount, int(tileBlock & 0x3Fu), bm, tidY);
    const size_t rowBytes = qwg_nax_row_bytes<AQ_BITS, AQ_GROUP, IS_SHVQ>(p);
    const uint wExp = isCold ? (e - residentE) : e;
    device const char* we = (isCold ? coldW : w) + size_t(wExp) * size_t(p.n) * rowBytes;
    device const half* xhe = xh + size_t(rowBase) * size_t(p.k);
    device const half* xle = xl + size_t(rowBase) * size_t(p.k);
    const uint3 tid = uint3(tg.x, tidY, 0);
    const uint mode = (bm == 16) ? 1u : ((bm == 32) ? 2u : 0u);
    if ((tileBlock & 0x80000000u) != 0u) {
        device half* ye16 = ((device half*)y32) + size_t(rowBase) * size_t(p.n);
        qwg_gemm_nax_split_mode_dispatch<AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, half>(
            we, xhe, xle, ye16, int(p.k), int(p.n), rowCount, mode, tid, simd_gid, tgLut);
    } else {
        device float* ye = y32 + size_t(rowBase) * size_t(p.n);
        qwg_gemm_nax_split_mode_dispatch<AQ_BITS, AQ_GROUP, IS_SHVQ, HAS_TG, float>(
            we, xhe, xle, ye, int(p.k), int(p.n), rowCount, mode, tid, simd_gid, tgLut);
    }
}
